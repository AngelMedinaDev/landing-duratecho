---
import Layout from '../layouts/Layout.astro';

const whatsappNumber = "528126177552";
const defaultWaMsg = "Hola DuraTecho, vengo de su página web. Me interesa una cotización para mi techo.";
---

<Layout title="DuraTecho | Impermeabilización en Monterrey con Garantía">
    
    <!-- NAVEGACIÓN -->
    <nav class="fixed top-0 w-full z-50 bg-white/95 backdrop-blur-md px-6 py-4 flex justify-between items-center shadow-md border-b-4 border-[#F58220]">
        <div class="flex items-center gap-2">
            <span class="font-title font-bold text-2xl text-[#1F2937] tracking-wider uppercase">Dura<span class="text-[#F58220]">Techo</span></span>
        </div>
        
        <div class="hidden md:flex gap-8 font-title text-[#1F2937] font-medium text-sm tracking-widest uppercase">
            <a href="#inicio" class="hover:text-[#F58220] transition-colors">Inicio</a>
            <a href="#servicios" class="hover:text-[#F58220] transition-colors">Soluciones</a>
            <a href="#galeria" class="hover:text-[#F58220] transition-colors">Proyectos</a>
            <a href="#beneficios" class="hover:text-[#F58220] transition-colors">¿Por qué nosotros?</a>
            <a href="#cotizar" class="hover:text-[#F58220] transition-colors">Cotizar</a>
        </div>

        <a href={`https://wa.me/${whatsappNumber}?text=${defaultWaMsg}`} target="_blank" rel="noopener noreferrer" aria-label="Contactar por WhatsApp" class="bg-[#F58220] hover:bg-[#e06b12] text-white px-5 py-2.5 rounded font-title uppercase tracking-wider font-bold transition-transform hover:scale-105 shadow-lg text-sm">
            WhatsApp Directo
        </a>
    </nav>

    <main class="pt-20 overflow-hidden">
        
        <!-- HERO SECTION -->
        <section id="inicio" class="relative min-h-[90vh] flex items-center bg-[#1F2937] text-white px-6 lg:px-20 py-20">
            <div class="absolute inset-0 z-0">
                <!-- A esta NO le ponemos lazy load porque es la primera que se ve -->
                <img src="https://images.unsplash.com/photo-1503387762-592deb58ef4e?q=80&w=1920&auto=format&fit=crop" alt="Impermeabilización de techos Monterrey" class="w-full h-full object-cover opacity-30 mix-blend-multiply" fetchpriority="high" />
            </div>

            <div class="relative z-10 max-w-3xl reveal">
                <div class="inline-block bg-[#F58220] text-white text-xs font-bold px-3 py-1 mb-6 font-title uppercase tracking-widest shadow-md">
                    Impermeabilización Residencial Acrílica
                </div>
                <h1 class="text-5xl md:text-7xl font-bold font-title uppercase leading-tight mb-6">
                    Tu techo siempre <br><span class="text-[#F58220]">da señales.</span>
                </h1>
                <p class="text-lg md:text-xl font-body text-gray-200 mb-10 max-w-2xl">
                    Las grietas pequeñas no son tan pequeñas. Somos los expertos en <strong>impermeabilización en Monterrey</strong>. Protegemos tu patrimonio con garantía de 5 años por escrito.
                </p>
                <div class="flex flex-wrap gap-4">
                    <a href="#cotizar" aria-label="Ir a la sección de cotización" class="bg-[#F58220] hover:bg-[#e06b12] text-white font-title font-bold uppercase tracking-widest py-4 px-8 rounded shadow-lg shadow-[#F58220]/40 transition-transform hover:-translate-y-1">
                        Cotizar Diagnóstico
                    </a>
                </div>
            </div>
        </section>

        <!-- SERVICIOS REALES -->
        <section id="servicios" class="py-24 bg-white px-6">
            <div class="max-w-6xl mx-auto">
                <div class="text-center mb-16 reveal">
                    <h2 class="text-[#F58220] font-title font-bold uppercase tracking-widest mb-2">Nuestro Proceso</h2>
                    <h3 class="text-4xl md:text-5xl font-title font-bold text-[#1F2937] uppercase">Impermeabilización Profesional</h3>
                </div>

                <div class="grid md:grid-cols-3 gap-8">
                    <!-- Servicio 1 -->
                    <div class="bg-slate-50 border-t-4 border-[#F58220] p-8 shadow-md hover:shadow-xl transition-all reveal group">
                        <img src="https://images.unsplash.com/photo-1632759145351-1d592919f522?q=80&w=600&auto=format&fit=crop" alt="Preparación de placa" loading="lazy" decoding="async" class="w-full h-40 object-cover rounded mb-6 opacity-90 group-hover:opacity-100 transition-opacity">
                        <h4 class="text-xl font-title font-bold text-[#1F2937] uppercase mb-3">Preparación de la Placa</h4>
                        <p class="text-gray-700 font-body text-sm mb-2">No solo pintamos. Preparamos el terreno para máxima adherencia:</p>
                        <ul class="list-disc pl-5 text-gray-700 font-body text-sm space-y-1">
                            <li>Raspado de material con falsa adherencia.</li>
                            <li>Barrido y sopleteado con aire a presión.</li>
                            <li>Retiro de asfáltico, poliuretano o chapopote viejo.</li>
                        </ul>
                    </div>
                    
                    <!-- Servicio 2 -->
                    <div class="bg-slate-50 border-t-4 border-[#1F2937] p-8 shadow-md hover:shadow-xl transition-all reveal group" style="transition-delay: 100ms;">
                        <img src="https://images.unsplash.com/photo-1643509867448-57001e0c333d?q=80&w=600&auto=format&fit=crop" alt="Aplicación de malla" loading="lazy" decoding="async" class="w-full h-40 object-cover rounded mb-6 opacity-90 group-hover:opacity-100 transition-opacity">
                        <h4 class="text-xl font-title font-bold text-[#1F2937] uppercase mb-3">Sellado e Impermeabilización</h4>
                        <p class="text-gray-700 font-body text-sm mb-2">Aplicación técnica para evitar cualquier filtración futura:</p>
                        <ul class="list-disc pl-5 text-gray-700 font-body text-sm space-y-1">
                            <li>Aplicación de sellador tapaporos.</li>
                            <li>Resane de grietas con cemento plástico.</li>
                            <li>Doble capa de impermeabilizante acrílico.</li>
                            <li>Colocación de malla de refuerzo estructural.</li>
                        </ul>
                    </div>
                    
                    <!-- Servicio 3 -->
                    <div class="bg-slate-50 border-t-4 border-[#F58220] p-8 shadow-md hover:shadow-xl transition-all reveal group" style="transition-delay: 200ms;">
                        <img src="https://images.pexels.com/photos/159358/construction-site-build-construction-work-159358.jpeg?auto=compress&cs=tinysrgb&w=600" alt="Trabajos especiales" loading="lazy" decoding="async" class="w-full h-40 object-cover rounded mb-6 opacity-90 group-hover:opacity-100 transition-opacity">
                        <h4 class="text-xl font-title font-bold text-[#1F2937] uppercase mb-3">Trabajos Especiales</h4>
                        <p class="text-gray-700 font-body text-sm mb-2">Nos adaptamos a las condiciones de tu propiedad:</p>
                        <ul class="list-disc pl-5 text-gray-700 font-body text-sm space-y-1">
                            <li>Maniobras seguras alrededor de celdas solares.</li>
                            <li>Trabajo especializado en techos con desniveles.</li>
                            <li>Cobertura en toda el área metropolitana de Monterrey.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECCIÓN DE GALERÍA -->
        <section id="galeria" class="py-24 bg-slate-50 px-6 border-t border-gray-200">
            <div class="max-w-6xl mx-auto">
                <div class="text-center mb-16 reveal">
                    <h2 class="text-[#F58220] font-title font-bold uppercase tracking-widest mb-2">Nuestro Trabajo</h2>
                    <h3 class="text-4xl font-title font-bold text-[#1F2937] uppercase">Resultados que hablan solos</h3>
                    <p class="text-gray-700 font-body mt-4 max-w-2xl mx-auto">Desliza para ver la calidad de nuestros acabados. Dejamos cada placa sellada, protegida y lista para resistir cualquier tormenta.</p>
                </div>
                
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 reveal">
                    <div class="overflow-hidden rounded-lg shadow-md aspect-square group relative">
                        <img src="https://images.unsplash.com/photo-1518481612222-68bbe828ecd1?q=80&w=600&auto=format&fit=crop" alt="Impermeabilización terminada" loading="lazy" decoding="async" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
                        <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-6">
                            <span class="text-white font-title font-bold uppercase tracking-wider text-sm">Aplicación de Malla</span>
                        </div>
                    </div>
                    <div class="overflow-hidden rounded-lg shadow-md aspect-square group relative">
                        <img src="https://images.unsplash.com/photo-1503387762-592deb58ef4e?q=80&w=600&auto=format&fit=crop" alt="Mantenimiento preventivo" loading="lazy" decoding="async" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
                        <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-6">
                            <span class="text-white font-title font-bold uppercase tracking-wider text-sm">Protección Total</span>
                        </div>
                    </div>
                    <div class="overflow-hidden rounded-lg shadow-md aspect-square group relative">
                        <img src="https://images.unsplash.com/photo-1632759145351-1d592919f522?q=80&w=600&auto=format&fit=crop" alt="Techo impermeabilizado" loading="lazy" decoding="async" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
                        <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-6">
                            <span class="text-white font-title font-bold uppercase tracking-wider text-sm">Acabado Premium</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECCIÓN BENEFICIOS -->
        <section id="beneficios" class="py-24 bg-white px-6 border-y border-gray-200">
            <div class="max-w-6xl mx-auto grid lg:grid-cols-2 gap-16 items-center">
                <div class="reveal">
                    <h2 class="text-[#F58220] font-title font-bold uppercase tracking-widest mb-2">Respaldo Total</h2>
                    <h3 class="text-4xl font-title font-bold text-[#1F2937] uppercase mb-8">El trabajo bien hecho no se tiene que hacer dos veces.</h3>
                    
                    <div class="space-y-6">
                        <div class="flex gap-4">
                            <div class="flex-shrink-0 w-12 h-12 bg-[#F58220] text-white rounded flex items-center justify-center font-bold text-xl font-title">1</div>
                            <div>
                                <h4 class="font-bold text-lg text-[#1F2937] uppercase font-title">Garantía por Escrito</h4>
                                <p class="text-gray-700 font-body">Te entregamos una garantía formal de 5 años en formato PDF directo a tu WhatsApp. Tu inversión está 100% protegida.</p>
                            </div>
                        </div>
                        <div class="flex gap-4">
                            <div class="flex-shrink-0 w-12 h-12 bg-[#1F2937] text-white rounded flex items-center justify-center font-bold text-xl font-title">2</div>
                            <div>
                                <h4 class="font-bold text-lg text-[#1F2937] uppercase font-title">Marcas Premium</h4>
                                <p class="text-gray-700 font-body">Más de 3 años de experiencia trabajando exclusivamente con materiales de primera: Impac, Kover de Berel e ImperCrest.</p>
                            </div>
                        </div>
                        <div class="flex gap-4">
                            <div class="flex-shrink-0 w-12 h-12 bg-[#F58220] text-white rounded flex items-center justify-center font-bold text-xl font-title">3</div>
                            <div>
                                <h4 class="font-bold text-lg text-[#1F2937] uppercase font-title">Atención Rápida</h4>
                                <p class="text-gray-700 font-body">Horario de atención de 7:00 am a 4:00 pm. Respondemos a la brevedad para evitar que la humedad siga dañando tu propiedad.</p>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="relative h-[500px] rounded-lg overflow-hidden shadow-2xl reveal">
                    <img src="https://images.unsplash.com/photo-1608806667067-66ebd8b169e8?q=80&w=800&auto=format&fit=crop" alt="Equipo de profesionales trabajando en reparación" loading="lazy" decoding="async" class="w-full h-full object-cover" />
                    <div class="absolute bottom-0 left-0 w-full bg-gradient-to-t from-black/90 to-transparent p-8">
                        <p class="text-white font-title font-bold text-2xl uppercase tracking-wider">Expertos en reparación. Cada centímetro sellado está respaldado.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- FORMULARIO DE CONTACTO A WHATSAPP -->
        <section id="cotizar" class="py-24 bg-[#1F2937] px-6">
            <div class="max-w-5xl mx-auto bg-white rounded-lg overflow-hidden shadow-2xl flex flex-col md:flex-row reveal">
                
                <div class="md:w-2/5 bg-[#F58220] text-white p-10 flex flex-col justify-center relative overflow-hidden">
                    <div class="relative z-10">
                        <h3 class="text-3xl font-title font-bold uppercase mb-4">Agenda tu visita</h3>
                        <p class="font-body mb-8 opacity-95">Mándanos un WhatsApp o márcanos directo para evaluar tu techo y armarte un presupuesto en Monterrey.</p>
                        <div class="font-title font-bold text-3xl tracking-widest mb-1">
                            81 2617 7552
                        </div>
                        <p class="font-body text-sm opacity-80 uppercase tracking-widest mb-6">Línea Directa</p>
                        
                        <a href="tel:+528126177552" aria-label="Llamar a DuraTecho" class="inline-flex items-center gap-2 bg-white text-[#F58220] font-title font-bold uppercase tracking-widest py-3 px-6 rounded-md shadow-md hover:bg-gray-100 transition-colors w-fit">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56a.977.977 0 00-1.01.24l-1.57 1.97c-2.83-1.35-5.48-3.9-6.89-6.83l1.95-1.66c.27-.28.35-.67.24-1.02-.37-1.11-.56-2.3-.56-3.53 0-.54-.45-.99-.99-.99H4.19C3.65 3 3 3.24 3 3.99 3 13.28 10.73 21 20.01 21c.71 0 .99-.63.99-1.18v-3.45c0-.54-.45-.99-.99-.99z"/></svg>
                            Llamar Ahora
                        </a>
                    </div>
                </div>

                <div class="md:w-3/5 p-10">
                    <form id="wa-form" class="flex flex-col gap-6 font-body">
                        <div class="grid md:grid-cols-2 gap-6">
                            <div>
                                <label for="nombre" class="block text-sm font-bold text-gray-800 mb-2">Nombre completo</label>
                                <input type="text" id="nombre" name="nombre" aria-label="Ingresa tu nombre completo" required class="w-full border-b-2 border-gray-300 py-2 focus:outline-none focus:border-[#F58220] transition-colors bg-transparent text-gray-800" placeholder="Ej. Juan Pérez">
                            </div>
                            <div>
                                <label for="zona" class="block text-sm font-bold text-gray-800 mb-2">Zona o Municipio</label>
                                <input type="text" id="zona" name="zona" aria-label="Ingresa tu zona o municipio" required class="w-full border-b-2 border-gray-300 py-2 focus:outline-none focus:border-[#F58220] transition-colors bg-transparent text-gray-800" placeholder="Ej. Cumbres, Monterrey">
                            </div>
                        </div>
                        
                        <div>
                            <label for="problema" class="block text-sm font-bold text-gray-800 mb-2">¿Qué servicio buscas?</label>
                            <select id="problema" name="problema" aria-label="Selecciona el servicio que buscas" class="w-full border-b-2 border-gray-300 py-2 focus:outline-none focus:border-[#F58220] bg-white transition-colors cursor-pointer text-gray-800">
                                <option value="Impermeabilización Acrílica Residencial">Impermeabilización Acrílica Residencial</option>
                                <option value="Reparación de Goteras / Humedad">Reparación de Goteras / Humedad</option>
                                <option value="Mantenimiento de placa con celdas solares">Mantenimiento de placa con celdas solares</option>
                                <option value="Evaluación general del techo">Evaluación general del techo</option>
                            </select>
                        </div>

                        <div>
                            <label for="detalles" class="block text-sm font-bold text-gray-800 mb-2">Detalles adicionales (Opcional)</label>
                            <textarea id="detalles" name="detalles" aria-label="Ingresa detalles adicionales de tu problema" rows="2" class="w-full border-b-2 border-gray-300 py-2 focus:outline-none focus:border-[#F58220] transition-colors bg-transparent text-gray-800" placeholder="Danos más detalles del techo..."></textarea>
                        </div>

                        <button type="submit" aria-label="Enviar información por WhatsApp" class="mt-4 bg-[#1F2937] hover:bg-black text-white font-title font-bold uppercase tracking-widest py-4 px-6 rounded transition-colors flex justify-center items-center gap-2 w-full group">
                            Enviar a WhatsApp 
                            <svg class="w-5 h-5 transform group-hover:translate-x-1 transition-transform" fill="currentColor" viewBox="0 0 24 24"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 6.46 17.5 2 12.04 2ZM17.47 16.59C17.23 17.26 16.27 17.82 15.54 17.96C15.01 18.06 14.28 18.12 11.36 16.91C7.62 15.36 5.17 11.53 4.99 11.29C4.81 11.06 3.53 9.36 3.53 7.59C3.53 5.82 4.43 4.96 4.79 4.6C5.08 4.3 5.56 4.18 5.98 4.18C6.12 4.18 6.24 4.18 6.36 4.19C6.67 4.22 6.82 4.24 7.02 4.73C7.26 5.32 7.84 6.74 7.91 6.89C7.99 7.04 8.08 7.23 7.97 7.42C7.88 7.61 7.81 7.72 7.64 7.91C7.48 8.1 7.32 8.24 7.15 8.45C6.98 8.64 6.79 8.85 7.01 9.23C7.23 9.6 7.82 10.57 8.71 11.36C9.85 12.38 10.77 12.7 11.18 12.87C11.53 13.02 11.95 12.98 12.19 12.73C12.5 12.42 12.87 11.89 13.25 11.35C13.53 10.96 13.88 10.92 14.23 11.05C14.59 11.18 16.48 12.11 16.86 12.3C17.25 12.49 17.5 12.58 17.59 12.73C17.69 12.89 17.69 13.72 17.47 16.59Z"/></svg>
                        </button>
                    </form>
                </div>
            </div>
        </section>

        <!-- FOOTER -->
        <footer class="bg-[#111827] py-12 border-t-4 border-[#F58220]">
            <div class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-6">
                <div class="text-center md:text-left">
                    <span class="font-title font-bold text-2xl text-white tracking-wider uppercase">Dura<span class="text-[#F58220]">Techo</span></span>
                    <p class="text-gray-400 font-body text-sm mt-2">Expertos en impermeabilización acrílica residencial en Monterrey.</p>
                </div>
                
                <div class="flex gap-4">
                    <a href="https://www.facebook.com/DuraTechoMty" target="_blank" rel="noopener noreferrer" aria-label="Visitar página de Facebook" class="bg-gray-800 hover:bg-[#F58220] text-white p-3 rounded-full transition-colors">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>
                    </a>
                </div>
            </div>
            
            <!-- Tu firma y Derechos -->
            <div class="mt-12 pt-8 border-t border-gray-800 text-center">
                <p class="text-gray-500 font-body text-xs uppercase tracking-widest font-medium">© {new Date().getFullYear()} DuraTecho Monterrey. Protegiendo tu patrimonio.</p>
                <p class="text-gray-600 font-body text-xs mt-3">
                    Sitio web desarrollado por <a href="https://angelmedinarivas.dev" target="_blank" rel="noopener noreferrer" aria-label="Visitar el portafolio del desarrollador web" class="text-gray-400 hover:text-[#F58220] transition-colors font-bold">Ángel Medina</a>
                </p>
            </div>
        </footer>
    </main>

    <!-- BOTÓN WHATSAPP FLOTANTE -->
    <a href={`https://wa.me/${whatsappNumber}?text=${defaultWaMsg}`} class="fixed bottom-6 right-6 bg-[#25D366] text-white p-4 rounded-full shadow-2xl hover:scale-110 hover:-rotate-6 transition-transform z-50 flex items-center justify-center" aria-label="Abrir chat de WhatsApp flotante" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 32 32" width="30" height="30" fill="white"><path d="M16 .396C7.163.396 0 7.56 0 16.396c0 2.89.756 5.6 2.078 7.96L.26 31.604l7.417-1.94A15.944 15.944 0 0016 32c8.837 0 16-7.163 16-16S24.837.396 16 .396zm0 29.07a13.01 13.01 0 01-6.63-1.83l-.475-.282-4.4 1.15 1.17-4.29-.31-.44a13.01 13.01 0 01-2.02-6.98C3.335 9.07 9.07 3.335 16 3.335S28.665 9.07 28.665 16 22.93 29.466 16 29.466zm7.36-9.73c-.4-.2-2.36-1.17-2.72-1.3-.36-.13-.62-.2-.88.2s-1 1.3-1.22 1.56c-.22.26-.44.3-.84.1s-1.7-.62-3.23-1.98c-1.2-1.06-2-2.36-2.24-2.76-.23-.4-.02-.62.18-.82.18-.18.4-.46.6-.7.2-.24.26-.4.4-.66.13-.26.07-.48-.03-.68s-.88-2.12-1.2-2.9c-.32-.77-.64-.66-.88-.67h-.75c-.26 0-.68.1-1.04.48-.36.4-1.36 1.33-1.36 3.23s1.4 3.74 1.6 4c.2.26 2.76 4.22 6.7 5.92.94.4 1.67.64 2.24.82.94.3 1.8.26 2.48.16.76-.12 2.36-.96 2.7-1.9.34-.94.34-1.74.24-1.9-.1-.16-.36-.26-.76-.46z"/></svg>
    </a>
</Layout>

<script is:inline>
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('active');
            }
        });
    }, { threshold: 0.15 });
    
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

    document.getElementById('wa-form').addEventListener('submit', function(e) {
        e.preventDefault();
        
        const nombre = document.getElementById('nombre').value;
        const problema = document.getElementById('problema').value;
        const zona = document.getElementById('zona').value;
        const detalles = document.getElementById('detalles').value;
        
        const telefono = "528126177552"; 
        
        let mensaje = `Hola DuraTecho, me interesa una cotización.%0A%0A*Mis datos:*%0A- Nombre: ${nombre}%0A- Servicio: ${problema}%0A- Zona: ${zona}`;
        
        if (detalles) {
            mensaje += `%0A- Detalles: ${detalles}`;
        }
        
        const url = `https://wa.me/${telefono}?text=${mensaje}`;
        window.open(url, '_blank');
    });
</script>