---
import Layout from '../layouts/Layout.astro';

// Datos de contacto de la plantilla
const whatsappNumber = "528126177552"; // Sin guiones para el enlace
const whatsappLink = `https://wa.me/${whatsappNumber}?text=Hola,%20vengo%20de%20su%20página%20web.%20Me%20interesa%20una%20cotización%20para%20impermeabilizar.`;
---

<Layout 
  title="DuraTecho | Especialistas en Impermeabilización en Monterrey"
  description="Protege tu hogar con DuraTecho. Impermeabilización acrílica residencial en toda el área metropolitana de Monterrey. Garantía de 5 años por escrito."
>

  <!-- SECCIÓN HERO (El primer impacto) -->
  <header class="bg-blue-900 text-white text-center py-20 px-4">
    <h1 class="text-4xl md:text-6xl font-bold mb-4">Que la lluvia no sea un problema</h1>
    <p class="text-xl md:text-2xl mb-8 max-w-2xl mx-auto">
      Expertos en impermeabilización acrílica residencial en toda el Área Metropolitana de Monterrey.
    </p>
    <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="bg-green-500 hover:bg-green-600 text-white font-bold py-4 px-8 rounded-full text-lg transition duration-300 shadow-lg inline-block">
      ¡Cotiza por WhatsApp Ahora!
    </a>
    <p class="mt-4 text-sm text-blue-200">Atención de 7:00 am a 4:00 pm</p>
  </header>

  <!-- SECCIÓN DE VALOR AGREGADO (Por qué elegirlos) -->
  <section class="py-16 px-4 max-w-6xl mx-auto">
    <h2 class="text-3xl font-bold text-center mb-12">¿Por qué confiar en DuraTecho?</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
      <div class="p-6 bg-white rounded-xl shadow-md">
        <h3 class="text-xl font-bold mb-2 text-blue-800">Garantía por Escrito</h3>
        <p>Te entregamos una garantía formal de 5 años en formato PDF directo a tu WhatsApp. Tu inversión está 100% protegida.</p>
      </div>
      <div class="p-6 bg-white rounded-xl shadow-md">
        <h3 class="text-xl font-bold mb-2 text-blue-800">Calidad Premium</h3>
        <p>Más de 3 años de experiencia trabajando exclusivamente con las mejores marcas: Impac, Kover de Berel e ImperCrest.</p>
      </div>
      <div class="p-6 bg-white rounded-xl shadow-md">
        <h3 class="text-xl font-bold mb-2 text-blue-800">Proceso a Detalle</h3>
        <p>No solo pintamos. Hacemos raspado, sopleteado a presión, sellado de grietas y aplicamos malla de refuerzo en cada trabajo.</p>
      </div>
    </div>
  </section>

  <!-- SECCIÓN DE SERVICIOS (Soluciones a la medida) -->
  <section class="bg-gray-200 py-16 px-4">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl font-bold text-center mb-4">Nuestras Soluciones de Impermeabilización</h2>
      <p class="text-center mb-10 text-gray-700">Adaptamos nuestro proceso profesional a las condiciones actuales de tu placa.</p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Servicio Base -->
        <div class="bg-white p-6 rounded-lg shadow-sm border-l-4 border-blue-600">
          <h3 class="text-lg font-bold mb-2">Impermeabilización Acrílica Base</h3>
          <ul class="list-disc pl-5 text-gray-700 space-y-1">
            <li>Raspado de material con falsa adherencia</li>
            <li>Barrido y sopleteado a presión</li>
            <li>Sellador tapaporos y resane de grietas</li>
            <li>Doble capa de impermeabilizante con malla de refuerzo</li>
          </ul>
        </div>
        
        <!-- Especialidades -->
        <div class="bg-white p-6 rounded-lg shadow-sm border-l-4 border-blue-600">
          <h3 class="text-lg font-bold mb-2">Trabajos Especiales</h3>
          <ul class="list-disc pl-5 text-gray-700 space-y-1">
            <li>Retiro de asfáltico, poliuretano o chapopote viejo</li>
            <li>Maniobras seguras con celdas solares instaladas</li>
            <li>Trabajo en techos con desniveles o inclinaciones</li>
            <li>Dejamos la placa original lista para el nuevo recubrimiento</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CALL TO ACTION FINAL -->
  <section class="text-center py-20 px-4">
    <h2 class="text-3xl font-bold mb-6">¿Listo para olvidarte de las goteras?</h2>
    <p class="text-lg mb-8 max-w-2xl mx-auto text-gray-600">
      Mándanos un mensaje con fotos de tu techo y con gusto te armamos un presupuesto. Cubrimos toda el área metropolitana de Monterrey.
    </p>
    <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="bg-green-500 hover:bg-green-600 text-white font-bold py-4 px-10 rounded-full text-xl transition duration-300 shadow-xl inline-flex items-center gap-2">
      <!-- Aquí puedes meter un ícono de WhatsApp SVG -->
      Mandar WhatsApp: 81-2617-7552
    </a>
  </section>

  <!-- FOOTER -->
  <footer class="bg-gray-900 text-gray-400 text-center py-6">
    <p>&copy; {new Date().getFullYear()} DuraTecho. Todos los derechos reservados.</p>
    <p class="text-sm mt-2">Expertos en mantenimiento residencial en Monterrey.</p>
  </footer>

</Layout>