---
const { title, description } = Astro.props;
---
<!DOCTYPE html>
<html lang="es-MX">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="keywords" content="impermeabilización en Monterrey, impermeabilizantes acrílicos, Impac, Berel, Crest, reparación de goteras Monterrey, DuraTecho" />
  <meta name="robots" content="index, follow" />
  
  <!-- Open Graph para cuando compartan el link en WhatsApp o Facebook -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_MX" />
  
  <title>{title}</title>
  
  <!-- Preconnect para cargar fuentes o scripts de Meta más rápido después -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
</head>
<body class="bg-gray-50 text-gray-900 font-sans antialiased">
  <slot />
</body>
</html>