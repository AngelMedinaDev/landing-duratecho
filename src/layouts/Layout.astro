---
import '../styles/global.css';

const { title } = Astro.props;
---

<!doctype html>
<html lang="es-MX" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        
        <!-- SEO Local y Meta Tags -->
        <title>{title || "DuraTecho | Especialistas en Impermeabilización en Monterrey"}</title>
        <meta name="description" content="Impermeabilización acrílica residencial con garantía de 5 años por escrito. Usamos marcas premium: Impac, Berel y Crest. Cotiza en Monterrey." />
        <meta name="keywords" content="impermeabilizacion, Monterrey, goteras, techos, reparar techo, Impac, Berel, Crest" />
        <meta name="robots" content="index, follow" />
        
        <!-- Schema.org para Inteligencia Artificial y Google Maps -->
        <script type="application/ld+json">
            {
              "@context": "https://schema.org",
              "@type": "RoofingContractor",
              "name": "DuraTecho",
              "image": "https://images.unsplash.com/photo-1503387762-592deb58ef4e",
              "telephone": "+528126177552",
              "address": {
                "@type": "PostalAddress",
                "addressLocality": "Monterrey",
                "addressRegion": "N.L.",
                "addressCountry": "MX"
              },
              "url": "https://duratecho.com.mx"
            }
        </script>

        <!-- Fuentes de Google -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;700&family=Roboto:wght@300;400;700&display=swap" rel="stylesheet">
    </head>
    <body class="m-0 w-full min-h-screen bg-[#F8F9FA] font-sans antialiased text-slate-800">
        <slot />
    </body>
</html>

<style is:global>
    .font-title { font-family: 'Oswald', sans-serif; }
    .font-body { font-family: 'Roboto', sans-serif; }
    
    :root {
        --brand-orange: #F58220;
        --brand-dark: #1F2937;
    }

    /* Animaciones Premium */
    .reveal {
        opacity: 0;
        transform: translateY(30px);
        transition: all 0.8s cubic-bezier(0.5, 0, 0, 1);
    }
    .reveal.active { 
        opacity: 1; 
        transform: translateY(0); 
    }
</style>